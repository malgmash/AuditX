# The team uses hosted Supabase Postgres and Supabase Storage (S3 API) instead of the Docker
# defaults below. Real values are in the gitignored env files. Ask the project owner for them.
# DATABASE_URL: use the Supabase Session pooler URL, with the password URL-encoded.
# S3_*: the Supabase Storage S3 endpoint is https://<project-ref>.storage.supabase.co/storage/v1/s3

# Copy to web/.env.local and analysis/.env, then change the secrets.

# In web/.env.local, end DATABASE_URL with ?connection_limit=3&pool_timeout=20 (or &... if the URL
# already has a query string). Prisma otherwise opens num_cpus * 2 + 1 connections per process,
# which is around 17 per person, and the shared Supabase pooler has a client cap that four people
# plus seed scripts will hit. pool_timeout=20 makes a queued request wait instead of failing with
# P2024. Both are Prisma-only parameters, so leave them out of analysis/.env: config.py strips only
# ?schema=, and libpq rejects anything else as an invalid connection option.
DATABASE_URL="postgresql://auditx:auditx@localhost:5432/auditx?schema=public&connection_limit=3&pool_timeout=20"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Sign-up requires this join code. Sign-up always creates an EMPLOYEE.
ORG_JOIN_CODE="auditx-join-2026"

# fixtures | db. Selects the data source for the admin and employee screens.
AUDITX_DATA="db"

# Object storage for receipt images
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="auditx"
S3_SECRET_KEY="auditx-dev-secret"
S3_BUCKET="receipts"

# Analysis service
ANALYSIS_URL="http://localhost:8000"

# NVIDIA NIM (OpenAI wire compatible)
NIM_API_KEY=""
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
# nemotron | gemini
INVESTIGATOR_PROVIDER="nemotron"
GEMINI_API_KEY=""
