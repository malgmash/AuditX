# Copy to web/.env.local and analysis/.env, then change the secrets.

DATABASE_URL="postgresql://auditx:auditx@localhost:5432/auditx?schema=public"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Sign-up requires this join code. Sign-up always creates an EMPLOYEE.
ORG_JOIN_CODE="auditx-join-2026"

# fixtures | db. Selects the data source for the admin and employee screens.
AUDITX_DATA="db"

# Object storage for receipt images
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="auditx"
S3_SECRET_KEY="auditx-dev-secret"
S3_BUCKET="receipts"

# Analysis service
ANALYSIS_URL="http://localhost:8000"

# NVIDIA NIM (OpenAI wire compatible)
NIM_API_KEY=""
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
# nemotron | gemini
INVESTIGATOR_PROVIDER="nemotron"
GEMINI_API_KEY=""
